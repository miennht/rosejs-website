# Runtime (Railway injects PORT automatically — do not set in dashboard unless debugging.)
# PORT=3000

# Build-time (set in Railway “Variables” for the *build* phase when you add a Vite env API.)
# VITE_EXAMPLE=

# Optional — contact form POST target (e.g. Formspree URL). See TASK-029 / ContactForm.
# VITE_FORM_ENDPOINT=

# Optional — Calendly scheduling URL for /schedule primary CTA.
# VITE_CALENDLY_URL=

# Optional — when Sanity is wired (see docs/Architecture.md §7.3).
# VITE_SANITY_PROJECT_ID=
# VITE_SANITY_DATASET=
