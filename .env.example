# Runtime (Railway injects PORT automatically — do not set in dashboard unless debugging.)
# PORT=3000

# Build-time (set in Railway “Variables” for the *build* phase when you add a Vite env API.)
# VITE_EXAMPLE=

# Optional — canonical site origin for OG URLs, JSON-LD, and sitemap alignment (no trailing slash).
# Production example: https://www.roseng.org
# VITE_SITE_URL=

# Optional — Plausible domain (e.g. rosejs.example); script loads only when set.
# VITE_PLAUSIBLE_DOMAIN=

# Optional — Calendly embed on /schedule when set to "true" (requires VITE_CALENDLY_URL).
# VITE_CALENDLY_EMBED=

# Optional — Calendly scheduling URL for /schedule primary CTA.
# VITE_CALENDLY_URL=

# Optional — contact form POST target (Formspree project URL). See Architecture §9.1.1.
# VITE_FORM_ENDPOINT=

# Optional — when Sanity is wired (see docs/Architecture.md §7.3).
# VITE_SANITY_PROJECT_ID=
# VITE_SANITY_DATASET=

# GitHub Actions: the default CI workflow in .github/workflows/ci.yml does not require repository secrets for MVP (lint, tests, build, E2E).
