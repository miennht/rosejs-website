# Runtime (Railway injects PORT automatically — do not set in dashboard unless debugging.)
# PORT=3000

# --- Railway BUILD variables (redeploy after changes) — see docs/Railway_Production_Variables.md ---

# Canonical origin (no trailing slash). Production: https://www.roseng.org
# VITE_SITE_URL=https://www.roseng.org

# Public contact email on /contact
# VITE_CONTACT_EMAIL=hello@roseng.org

# Plausible — use the site/domain configured in Plausible dashboard
# VITE_PLAUSIBLE_DOMAIN=roseng.org

# Calendly — scheduling URL; embed on /schedule (default on unless false)
# VITE_CALENDLY_URL=https://calendly.com/roseng0201/30min
# VITE_CALENDLY_EMBED=true

# Formspree (or compatible) POST URL — see Architecture §9.1.1
# VITE_FORM_ENDPOINT=

# Optional — show LinkedIn block on /contact when set
# VITE_LINKEDIN_URL=

# Optional — when Sanity is wired (see docs/Architecture.md §7.3)
# VITE_SANITY_PROJECT_ID=
# VITE_SANITY_DATASET=production

# Local only — copy to .env.local for development (never commit .env.local)
# GitHub Actions: CI does not require repository secrets for MVP (lint, tests, build, E2E).
